# Dependencies
node_modules

# Build output
dist
dist-ssr
*.tsbuildinfo

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Local overrides
*.local

# Environment files
.env
.env.*
!.env.example

# Tauri / Rust build output (src-tauri/.gitignore also covers these)
src-tauri/target
src-tauri/gen/schemas

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
.fleet
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Lockfile stays tracked even if a global ignore rule says otherwise
!pnpm-lock.yaml
/.vscode/
/working/
